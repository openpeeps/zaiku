div.p-4
  div.mb-5.text-center
    h1.display-1: "Zaiku"
    h2.h1.text-gray-500: "細工"
    p.lead.mt-3: "A lightweight CSS framework with server-driven form validation, preloaders, card effects, tabs, progress bars, and more."

  div.row.g-3
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/typography"
        h5.h3.card-title: "Typography"
        p.text-gray-500: "Headings, paragraphs, text links."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/buttons"
        h5.h3.card-title: "Buttons"
        p.text-gray-500: "Button variants, groups, preloaders."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/badges"
        h5.h3.card-title: "Badges"
        p.text-gray-500: "Badges, breadcrumbs, keyboard."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/cards"
        h5.h3.card-title: "Cards"
        p.text-gray-500: "Cards, hover effects, gradients."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/forms"
        h5.h3.card-title: "Forms"
        p.text-gray-500: "Inputs, switches, checkboxes, validation."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/tags"
        h5.h3.card-title: "Tags"
        p.text-gray-500: "Tag input with autocomplete and validation."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/chatbox"
        h5.h3.card-title: "Chatbox"
        p.text-gray-500: "Chat input with toolbar."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/alerts"
        h5.h3.card-title: "Alerts"
        p.text-gray-500: "Alert variants, toasts."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/clipboard"
        h5.h3.card-title: "Clipboard"
        p.text-gray-500: "Copy-to-clipboard with feedback."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/progress"
        h5.h3.card-title: "Progress"
        p.text-gray-500: "Progress bars, loading animations."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/tabs"
        h5.h3.card-title: "Tabs"
        p.text-gray-500: "Tabbed navigation with hash support."
    div.col-4
      a.card.p-4.rounded-4.text-center.text-decoration-none href="/components/accordion"
        h5.h3.card-title: "Accordion"
        p.text-gray-500: "Expandable sections with chevron icons."
