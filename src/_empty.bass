.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 2rem;
  gap: 1.5rem;
}

.empty header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  max-width: 28rem;
}

.empty figure {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  color: var(--color-gray-400);
  margin-bottom: 0.25rem;
}

.empty figure svg {
  width: 100%;
  height: 100%;
}

.empty h3 {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-gray-900);
  margin: 0;
}

.empty p {
  font-size: 0.9rem;
  color: var(--color-gray-500);
  line-height: 1.6;
  margin: 0;
}

.empty footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  max-width: 28rem;
}

.empty footer .input-group {
  width: 100%;
}

.empty footer p {
  font-size: 0.85rem;
}
