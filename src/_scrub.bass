/* Scrub input widget (data-zaiku-scrub) */
.input-scrub {
  display: inline-flex;
  align-items: center;
  position: relative;
  cursor: ew-resize;
  user-select: none;
  font-family: inherit;
  font-size: inherit;
  line-height: 1.5;
}

.input-scrub-value {
  display: inline-flex;
  align-items: center;
  padding: 0.375rem 0.75rem;
  border: 1px solid var(--color-gray-300);
  border-radius: var(--radius-md);
  background: var(--color-white);
  color: var(--color-gray-900);
  font-variant-numeric: tabular-nums;
  min-width: 4rem;
  transition: border-color var(--transition-fast) ease, background var(--transition-fast) ease;
}

.input-scrub:hover .input-scrub-value {
  border-color: var(--color-gray-400);
}

.input-scrub.is-dragging .input-scrub-value {
  border-color: var(--color-primary-500);
  background: var(--color-primary-50);
}

.input-scrub-field {
  display: none;
  position: absolute;
  inset: 0;
  padding: 0.375rem 0.75rem;
  border: 1px solid var(--color-primary-500);
  border-radius: var(--radius-md);
  outline: none;
  font-family: inherit;
  font-size: inherit;
  line-height: 1.5;
  background: var(--color-white);
  color: var(--color-gray-900);
}

.input-scrub.is-editing .input-scrub-value {
  visibility: hidden;
}

.input-scrub.is-editing .input-scrub-field {
  display: inline-flex;
}
