/* Sizing, viewport, z-index and overflow utilities */
.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}


.min-vh-100 {
  min-height: 100vh;
}

.text-decoration-none {
  text-decoration: none;
}


.h-100 {
  height: 100%
}

.vh-100 {
  height: 100vh;
}

.vh-50 {
  height: 50vh;
}

.z-index-1 {
  z-index: 1000
}


.overflow-hidden {
  overflow: hidden
}
