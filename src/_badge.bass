@layer components {
/* Badges — extracted from style.bass */
  /* Base badge – already defined, kept for reference */
  .badge {
    display: inline-flex;
    width: fit-content;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 1);
    overflow: hidden;
    border-radius: var(--badge-radius, 24px);
    border-style: solid;
    border-width: 1px;
    padding-inline: calc(var(--spacing) * 2);
    padding-block: calc(var(--spacing) * 0.2);
    white-space: nowrap;
    font-size: 0.79rem;
    font-weight: 500;
    transition: color var(--transition-fast) ease, background-color var(--transition-fast) ease,
                border-color var(--transition-fast) ease, box-shadow var(--transition-fast) ease;
  }

  .badge-bar {
    padding-inline: 0.15rem;
    padding-right: 0.35rem;
    gap: 0.2rem;
  }

  /* Color variants — one `case` branch per variant (bowdy maps only accept numeric values) */
  for $v in range(1, 4):
    case $v
    of 1:
      .badge-primary {
        background-color: var(--color-primary-100);
        color: var(--color-primary-800);
        border-color: var(--color-primary-200);
      }
      .badge-primary:hover {
        background-color: var(--color-primary-200);
      }
    of 2:
      .badge-secondary {
        background-color: var(--color-gray-100);
        color: var(--color-gray-800);
        border-color: var(--color-gray-200);
      }
      .badge-secondary:hover {
        background-color: var(--color-gray-200);
      }
    of 3:
      .badge-danger {
        background-color: var(--color-danger-500);
        color: #fff;
        border-color: var(--color-danger-500);
      }
      .badge-danger:hover {
        background-color: #dc2626; /* a bit darker */
      }
    of 4:
      .badge-outline {
        background-color: transparent;
        color: var(--color-primary-600);
        border-color: var(--color-primary-300);
      }
      .badge-outline:hover {
        background-color: var(--color-primary-50);
      }

  /* Size variants */
  .badge-sm {
    font-size: 0.65rem;
    padding-inline: calc(var(--spacing) * 1.5);
    padding-block: calc(var(--spacing) * 0.25);
  }

  .badge-lg {
    font-size: 0.9rem;
    padding-inline: calc(var(--spacing) * 2.5);
    padding-block: calc(var(--spacing) * 0.75);
  }

  .badge-counter {
    font-size: 0.65rem;
    padding-inline: 0.4rem;
    padding-block: 0.05rem;
    min-width: 1.2rem;
    min-height: 1.2rem;
    border-radius: 999px;
    line-height: 1;
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border-radius: 50%;
    border: none;
  }

  .badge-position-top-right {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
  }

  /* Status */
  
  .badge.badge-status:before {
    content: "";
    display: inline-block;
    width: var(--status-dot-size);
    height: var(--status-dot-size);
    padding: 0;
    border-radius: 10px;
    background-color: var(--color-success-500);
    box-shadow: 0 0 0 0 rgba(var(--color-success-500-rgb), 0.95);
    transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
  }

  .badge.badge-status.badge-status-animate:before {
    animation: pulse var(--status-pulse-duration) ease-out infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
}
