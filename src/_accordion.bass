/* Accordion */
.accordion {
  border: 1px solid var(--color-gray-200);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.accordion-borderless {
  border: none;
  border-radius: 0;
  overflow: visible;
}

.accordion-item {
  border-bottom: 1px solid var(--color-gray-200);
}

.accordion-item:last-child {
  border-bottom: none;
}

.accordion-header {
  display: flex;
  width: 100%;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1rem;
  background: none;
  border: none;
  cursor: pointer;
  font-size: inherit;
  color: var(--color-gray-900);
  text-align: left;
  gap: 0.5rem;
  font-weight: 500;
  font-family: inherit;
  line-height: 1.5;
  transition: background-color var(--transition-fast) ease;
}

.accordion-header:hover {
  background-color: var(--color-gray-50);
}

.accordion-chevron {
  flex-shrink: 0;
  transition: transform var(--transition-normal) ease;
}

.accordion-header.active .accordion-chevron {
  transform: rotate(180deg);
}

.accordion-content {
  display: none;
}

.accordion-scrollable .accordion-content {
  max-height: 240px;
  overflow-y: auto;
}

.accordion-media {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
  background-color: var(--color-gray-100);
}

.accordion-media iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.accordion-body {
  padding: 0 1rem 1rem;
  color: var(--color-gray-600);
  font-size: 0.92rem;
  line-height: 1.6;
}

.accordion-item.disabled .accordion-header,
.accordion-header[disabled] {
  cursor: not-allowed;
  opacity: 0.5;
  pointer-events: none;
}
