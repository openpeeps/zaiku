.img-fluid {
  max-width: 100%;
  height: auto;
}

.img-rounded {
  border-radius: var(--radius-lg);
}

.img-circle {
  border-radius: 50%;
}

.img-thumbnail {
  padding: 0.25rem;
  background: var(--color-white);
  border: 1px solid var(--color-gray-200);
  border-radius: var(--radius-md);
}

.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-contain {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.figure {
  display: inline-flex;
  flex-direction: column;
  gap: 0.5rem;
  margin: 0;
}

.figure-img {
  line-height: 0;
}

.figure-caption {
  font-size: 0.85rem;
  color: var(--color-gray-500);
  text-align: center;
}
