div.p-4
  div.mb-5
    h2.h1: "Popovers"
    p.lead.mb-3: "Add .popover to any .dropdown to turn it into a popover. Use data-popover-placement to set the side."
    div.card.p-5.my-3
      h5.h3.mb-3: "Placement sides"
      p.mb-3: "Set data-popover-placement to top, right, bottom, or left. The arrow automatically points back to the trigger."
      div.d-flex.gap-4.flex-wrap.align-items-center
        div.dropdown.popover data-popover-placement="top"
          button.btn.btn-primary.dropdown-toggle: "Top"
          div.dropdown-menu
            div.px-3.py-2.text-sm: "Popover content on the top side."
            hr.dropdown-divider
            button.dropdown-item: "Action"
        div.dropdown.popover data-popover-placement="right"
          button.btn.btn-secondary.dropdown-toggle: "Right"
          div.dropdown-menu
            div.px-3.py-2.text-sm: "Popover content on the right side."
            hr.dropdown-divider
            button.dropdown-item: "Action"
        div.dropdown.popover data-popover-placement="bottom"
          button.btn.btn-outline.dropdown-toggle: "Bottom"
          div.dropdown-menu
            div.px-3.py-2.text-sm: "Popover content on the bottom side."
            hr.dropdown-divider
            button.dropdown-item: "Action"
        div.dropdown.popover data-popover-placement="left"
          button.btn.btn-danger.dropdown-toggle: "Left"
          div.dropdown-menu
            div.px-3.py-2.text-sm: "Popover content on the left side."
            hr.dropdown-divider
            button.dropdown-item: "Action"
    div.card.p-5.my-3
      h5.h3.mb-3: "Rich content"
      p.mb-3: "Popovers can contain forms, images, or any HTML content inside the dropdown-menu body."
      div.d-flex.gap-4.flex-wrap
        div.dropdown.popover data-popover-placement="bottom"
          button.btn.btn-primary.dropdown-toggle: "Sign In"
          div.dropdown-menu style="min-width:280px"
            div.p-3
              div.field
                label.field-label for="popover-email": "Email"
                input#popover-email.input type="email" placeholder="you@example.com"
              div.field.mt-2
                label.field-label for="popover-pass": "Password"
                input#popover-pass.input type="password" placeholder="Enter password"
              button.btn.btn-primary.mt-2.w-full: "Sign In"
        div.dropdown.popover data-popover-placement="bottom"
          button.btn.btn-secondary.dropdown-toggle: "Notifications"
          div.dropdown-menu style="min-width:300px"
            div.px-3.py-2.d-flex.align-items-center.gap-3
              span.badge.badge-dot.badge-success
              div.flex-1
                div.text-sm.fw-medium: "New message from Alice"
                div.text-xs.text-gray: "2 minutes ago"
            hr.dropdown-divider
            div.px-3.py-2.d-flex.align-items-center.gap-3
              span.badge.badge-dot.badge-success
              div.flex-1
                div.text-sm.fw-medium: "Your report is ready"
                div.text-xs.text-gray: "1 hour ago"
            hr.dropdown-divider
            div.px-3.py-2.text-center
              a.text-sm.text-link href="#": "View all notifications"

@javascript
Zaiku.ready(function() {
  document.querySelectorAll('.popover').forEach(function(el) {
    new Zaiku.Dropdown(el)
  })
});
  @end
