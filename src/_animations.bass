/* Keyframes and animation helpers */
@keyframes spin-text {
  to { transform: rotate(360deg); }
}

.rotating-badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 5em;
  height: 5em;
}

.rotating-badge > svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  animation: spin-text 10s linear infinite;
  color: inherit;
}

.rotating-badge-icon {
  position: relative;
  width: 1.6em;
  height: 1.6em;
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
}

@keyframes ping-pong {
  0%, 100% { transform: rotate(-12deg); }
  50% { transform: rotate(12deg); }
}

.ping-pong {
  animation: ping-pong 1.5s ease-in-out infinite;
}

.pulse-dot {
  display: inline-flex;
  width: 0.5em;
  height: 0.5em;
  border-radius: 50%;
  background-color: currentColor;
  animation: pulse 2s ease-in-out infinite;
}
