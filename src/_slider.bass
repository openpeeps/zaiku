.zaiku-slider {
  position: relative;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
}

.zaiku-slider-track {
  display: flex;
  align-items: flex-start;
  transition: transform 0.35s ease;
  will-change: transform;
}

.zaiku-slider-track.no-transition {
  transition: none;
}

.zaiku-slider-slide {
  flex: 0 0 auto;
  min-width: 0;
}

.zaiku-slider-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 2.25rem;
  height: 2.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-white);
  border: 1px solid var(--color-gray-200);
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
  color: var(--color-gray-700);
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
  transition: background var(--transition-fast) ease, box-shadow var(--transition-fast) ease;
}

.zaiku-slider-btn:hover {
  background: var(--color-gray-100);
  box-shadow: var(--shadow-md);
}

.zaiku-slider-btn-prev {
  left: 0.5rem;
}

.zaiku-slider-btn-next {
  right: 0.5rem;
}

.zaiku-slider-pagination {
  display: flex;
  justify-content: center;
  gap: 0.375rem;
  padding: 0.5rem 0;
}

.zaiku-slider-pagination-item {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--color-gray-300);
  border: none;
  cursor: pointer;
  transition: background var(--transition-fast) ease;
  padding: 0;
}

.zaiku-slider-pagination-item.active {
  background: var(--color-gray-700);
}

.zaiku-slider-pagination-item:hover {
  background: var(--color-gray-500);
}

.zaiku-slider-counter {
  position: absolute;
  right: 0.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  z-index: 5;
  pointer-events: none;
}

.zaiku-slider-counter.top {
  top: 0.5rem;
}

.zaiku-slider-counter.bottom {
  bottom: 0.5rem;
}

.zaiku-slider-timer-wrap {
  position: absolute;
  top: 5px;
  left: 0;
  right: 0;
  z-index: 5;
  pointer-events: none;
  padding: 0 1rem;
}

.zaiku-slider-timer {
  height: 4px;
  background: var(--color-gray-300);
  width: 0%;
  border-radius: 8px;
}

.zaiku-slider-track.vertical {
  flex-direction: column;
}

.zaiku-slider-btn.vertical {
  left: 50%;
  right: auto;
  transform: translateX(-50%);
}

.zaiku-slider-btn-prev.vertical {
  top: 0.5rem;
  bottom: auto;
}

.zaiku-slider-btn-next.vertical {
  bottom: 0.5rem;
  top: auto;
}

.zaiku-slider-pagination.vertical {
  flex-direction: column;
  left: auto;
  bottom: auto;
  top: 50%;
  right: 0.5rem;
  transform: translateY(-50%);
  padding: 0;
}

.zaiku-slider-pagination.vertical.left {
  left: 0.5rem;
  right: auto;
}

.zaiku-slider-pie-wrap {
  position: absolute;
  z-index: 5;
  pointer-events: none;
  line-height: 0;
}

.zaiku-slider-pie-wrap.tr { top: 0.5rem; right: 0.5rem; }
.zaiku-slider-pie-wrap.tl { top: 0.5rem; left: 0.5rem; }
.zaiku-slider-pie-wrap.br { bottom: 0.5rem; right: 0.5rem; }
.zaiku-slider-pie-wrap.bl { bottom: 0.5rem; left: 0.5rem; }
